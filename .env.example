# App
NEXT_PUBLIC_APP_URL=http://localhost:2000

# Capacitor (native iOS/Android) — URL the app WebView loads
# Android emulator: http://10.0.2.2:2000
# Phone on Wi‑Fi:   http://YOUR_LAN_IP:2000
# Production:       https://your-domain.com
CAPACITOR_SERVER_URL=http://localhost:2000

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: checkout currency (enable it in Stripe Dashboard first)
# STRIPE_CHECKOUT_CURRENCY=usd

# AdMob (Capacitor native rewarded ads)
# Defaults to Google sample IDs when unset — fine for emulator.
# Create an app + Rewarded unit at https://apps.admob.com then set:
# NEXT_PUBLIC_ADMOB_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyyyy
# NEXT_PUBLIC_ADMOB_REWARDED_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzzzz
# Also paste the App ID into android/.../strings.xml (admob_app_id)
# and ios/App/App/Info.plist (GADApplicationIdentifier).
# NEXT_PUBLIC_ADMOB_TESTING=true
# Set to false only with your real production unit IDs.
NEXT_PUBLIC_ADMOB_TESTING=true
